        uint256 _couponDiscount
    ) external onlyRole(ADMIN_ROLE) {
        if (_startTime > 0) presaleInfo.startTime = _startTime;
        if (_endTime > 0) presaleInfo.endTime = _endTime;
        if (_maxTokensToSell > 0)
            presaleInfo.maxTokensToSell = _maxTokensToSell;
        if (_minPurchaseTokensUSD > 0)
            presaleInfo.minPurchaseTokensUSD = _minPurchaseTokensUSD;
        if (_minPurchaseTokensETH > 0)
            presaleInfo.minPurchaseTokensETH = _minPurchaseTokensETH;
        if (_whitelistDiscount > 0)
            presaleInfo.whitelistDiscount = _whitelistDiscount;
        if (_couponDiscount > 0) presaleInfo.couponDiscount = _couponDiscount;
    }

    function updatePayeeAddress(address _payeeAddress)
        external
        onlyRole(ADMIN_ROLE)
    {
        require(_payeeAddress != address(0), "Cannot set zero address");
        presaleInfo.payeeAddress = _payeeAddress;
    }

    /**
     * @dev Updates the Merkle root for whitelisting.
     * @param _merkleRoot New Merkle root.
     */
    function updateMerkleRoot(bytes32 _merkleRoot)
        external
        onlyRole(ADMIN_ROLE)
    {
        if (_merkleRoot != bytes32(0)) presaleInfo.merkleRoot = _merkleRoot;
    }

    /**
     * @dev Sets the active status of a signer address.
     * @param _signer Address of the signer.
     * @param _active True to activate the signer, false to deactivate.
     */
    function setActiveSigner(address _signer, bool _active)
        public
        onlyRole(ADMIN_ROLE)
    {
        require(_signer != address(0), "Cannot set zero address");
        activeSigner[_signer] = _active;
    }

    /**
     * @dev Updates the token prices in different currencies.
     * @param _ethPrice New price of the token in ETH.
     * @param _usdtPrice New price of the token in USDT.
     * @param _usdcPrice New price of the token in USDC.
     */
    function updateTokenPrice(
        uint256 _ethPrice,
        uint256 _usdtPrice,
        uint256 _usdcPrice
    ) external {
        if (hasRole(ADMIN_ROLE, msg.sender)) {
            // Admin can increase/decrse the price
            if (_ethPrice > 0) {
                tokenPrice.ETH = _ethPrice;
            }
            if (_usdtPrice > 0) {
                tokenPrice.USDT = _usdtPrice;
            }
            if (_usdcPrice > 0) {
                tokenPrice.USDC = _usdcPrice;
            }
        } else if (hasRole(PRICE_UPGRADER_ROLE, msg.sender)) {
            // Price upgrader can only increase the prices
            if (_ethPrice > 0) {
                require(
                    _ethPrice > tokenPrice.ETH,
                    "Price can only be increased"
                );
                tokenPrice.ETH = _ethPrice;
            }
            if (_usdtPrice > 0) {
                require(
                    _usdtPrice > tokenPrice.USDT,
                    "Price can only be increased"
                );
                tokenPrice.USDT = _usdtPrice;
            }
            if (_usdcPrice > 0) {
                require(
                    _usdcPrice > tokenPrice.USDC,
                    "Price can only be increased"
                );
                tokenPrice.USDC = _usdcPrice;
            }
        } else {
            revert("Caller is not authorized to update token prices");
        }
    }

    /**
     * @dev Verifies if an address is a whitelisted or not using Merkle proof.
     * @param _address Address to verify.
     * @param _proof Merkle proof for the verification.
     * @return True if the address is whitelisted otherwise false.
     */
    function isWhitelisted(address _address, bytes32[] memory _proof)
        public
        view
        returns (bool)
    {
        bytes32 leaf = keccak256(abi.encodePacked(_address));
        return MerkleProof.verify(_proof, presaleInfo.merkleRoot, leaf);
    }

    /**
     * @dev Handles the purchase of tokens. Supports payments in ETH, USDT, and USDC.
     * @param purchaseParams parameters including amount, currency, coupon, expiry, nonce, signature, and Merkle proof.
     */
    function purchaseTokens(PurchaseParams calldata purchaseParams)
        external
        payable
        nonReentrant
    {
        // Validate that the presale is active by checking the current time against the presale start and end times.
        // Note: Using '>' for start time to account for the start time being set 1 second before the actual start.
        bytes32 currency = keccak256(abi.encodePacked(purchaseParams.currency));

        require(
            block.timestamp > presaleInfo.startTime &&
                block.timestamp < presaleInfo.endTime,
            "Sale is not active"
        );
        require(currency == CURR_USDT, "Please select USDT");
        require(
            purchaseParams.amount > 0,
            "Amount should be greater than zero"
        );
        // Ensure the payment amount meets or exceeds the minimum purchase threshold for USDT.
        // note : using < instead of <= because the max tokens will be set minPurchaseTokensUSD - 1.
        require(
            purchaseParams.amount > presaleInfo.minPurchaseTokensUSD,
            "Minimum purchase amount not met"
        );

        // If a coupon is provided, validate the coupon's signature and check if the signature has expired.
        if (bytes(purchaseParams.coupon).length > 0) {
            require(
                activeSigner[recoverSigner(purchaseParams)],
                "Invalid Signature"
            );
            require(
                purchaseParams.expiry > block.timestamp,
                "Signature is expired"
            );
        }

        // Determine the price of tokens in the specified currency and apply any applicable discounts.
        (uint256 tokenPriceInCurrency, uint256 discount) = getTokenPrice(
            purchaseParams,
            msg.sender
        );

        uint256 tokenToAllocate;
        uint256 scaledValue;

        // Calculate the scaled value based on the currency used for payment.
        // If ETH is used, the value is taken from msg.value.
        // For other currencies (USDT/USDC), the value is taken from purchaseParams.amount.

        scaledValue = purchaseParams.amount * TOKEN_DECIMALS;

        // Calculate the number of tokens to allocate based on the scaled value and token price.
        tokenToAllocate = scaledValue / tokenPriceInCurrency;

        // Ensure that the total tokens sold does not exceed the maximum tokens available for sale.
        // note : using < instead of <= because the max tokens will be set maxtokensToSell - 1.
        require(
            presaleInfo.totalTokensSold + tokenToAllocate <
                presaleInfo.maxTokensToSell,
            "Exceeds max tokens to sell"
        );

        // Handle payments based on the chosen currency.
        // Verify the allowance and balance for USDT.
        require(
            USDT.allowance(msg.sender, address(this)) >= purchaseParams.amount,
            "Allowance is less than USDT amount"
        );
        require(
            USDT.balanceOf(msg.sender) >= purchaseParams.amount,
            "Insufficient USDT balance"
        );
        amountRaised.USDT += purchaseParams.amount;
        amountRaised.SUM += purchaseParams.amount;
        // Transfer USDT to the presale's payee address.
        USDT.transferFrom(
            msg.sender,
            presaleInfo.payeeAddress,
            purchaseParams.amount
        );

        // Record the purchase by adding it to the list of purchases for the sender's address.
        purchasesByAddress[msg.sender].push(
            Purchase({
                amount: purchaseParams.amount,
                currency: purchaseParams.currency,
                tokensPurchased: tokenToAllocate,
                discount: discount,
                coupon: purchaseParams.coupon,
                timestamp: block.timestamp
            })
        );

        // Update the total number of tokens sold with the amount of tokens allocated.
        presaleInfo.totalTokensSold += tokenToAllocate;

        // Emit an event to log the token purchase details.
        emit TokensPurchased(
            msg.sender,
            purchaseParams.amount,
            purchaseParams.currency,
            purchaseParams.coupon,
            tokenToAllocate,
            discount,
            block.timestamp
        );
    }

    /**
     * @dev Calculates the token price based on the provided currency and applies any applicable discounts.
     * @param purchaseParams Struct containing purchase parameters including currency, coupon, and Merkle proof.
     * @param buyer Address of the buyer, used for checking whitelist status.
     * @return price The adjusted price per token after applying any discounts.
     * @return discount The total discount applied, represented in basis points (parts per thousand).
     */

    function getTokenPrice(PurchaseParams memory purchaseParams, address buyer)
        public
        view
        returns (uint256, uint256)
    {
        uint256 price;
        uint256 discount = 0;

        bytes32 currency = keccak256(abi.encodePacked(purchaseParams.currency));

        // Determine base price based on currency
        if (currency == CURR_ETH) {
            price = tokenPrice.ETH;
        } else if (currency == CURR_USDT) {
            price = tokenPrice.USDT;
        } else if (currency == CURR_USDC) {
            price = tokenPrice.USDC;
        } else {
            revert("Invalid currency");
        }

        // Apply whitelisted discount if applicable
        if (
            buyer != address(0) &&
            purchaseParams.merkleProof.length > 0 &&
            isWhitelisted(buyer, purchaseParams.merkleProof)
        ) {
            price = (price * (1000 - presaleInfo.whitelistDiscount)) / 1000;
            discount = presaleInfo.whitelistDiscount;
            return (price, discount);
        }

        // Apply coupon discount if applicable
        if (
            bytes(purchaseParams.coupon).length > 0 &&
            activeSigner[recoverSigner(purchaseParams)]
        ) {
            price = (price * (1000 - presaleInfo.couponDiscount)) / 1000;
            discount = presaleInfo.couponDiscount;
            return (price, discount);
        }

        return (price, discount);
    }

    /**
     * @dev Recovers the signer's address from the provided purchase parameters and signature.
     *      This function is used to verify that a message was signed by a valid signer.
     * @param purchaseParams Struct containing purchase details including amount, currency, coupon, nonce, expiry, and signature.
     * @return The address of the signer who signed the purchase data.
     */
    function recoverSigner(PurchaseParams memory purchaseParams)
        internal
        view
        returns (address)
    {
        bytes32 digest = _hashTypedDataV4(
            keccak256(
                abi.encode(
                    PURCHASE_AUTH_TYPE_HASH,
                    purchaseParams.amount,
                    keccak256(bytes(purchaseParams.currency)),
                    keccak256(bytes(purchaseParams.coupon)),
                    purchaseParams.nonce,
                    purchaseParams.expiry
                )
            )
        );
        return ECDSA.recover(digest, purchaseParams.signature);
    }

    /**
     * @dev Retrieves the purchase history for a given wallet address.
     *      This function returns an array of `Purchase` structs representing all token purchases made by the specified address.
     * @param _walletAddress The address of the wallet whose purchase history is being queried.
     * @return An array of `Purchase` structs containing details of each purchase made by the specified wallet address.
     */
    function getPurchaseHistory(address _walletAddress)
        external
        view
        returns (Purchase[] memory)
    {
        return purchasesByAddress[_walletAddress];
    }

    /**
     * @dev Withdraws the collected funds by the admin.
     */
    function withdrawFunds() external onlyRole(ADMIN_ROLE) nonReentrant {
        address payable payee = payable(presaleInfo.payeeAddress);

        uint256 ethBalance = address(this).balance;
        if (ethBalance > 0) {
            (bool success, ) = payee.call{value: ethBalance}("");
            require(success, "ETH withdrawal failed");
        }

        uint256 usdtBalance = USDT.balanceOf(address(this));
        if (usdtBalance > 0) {
            USDT.transfer(payee, usdtBalance);
        }
    }

    /**
     * @dev Authorizes contract upgrades by ensuring only ADMIN_ROLE can perform upgrades.
     * @param newImplementation Address of the new contract implementation.
     */
    function _authorizeUpgrade(address newImplementation)
        internal
        override
        onlyRole(ADMIN_ROLE)
    {}
}