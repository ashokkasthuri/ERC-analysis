/// SPDX-License-Identifier: UNLICENSED
// solhint-disable ordering
pragma solidity 0.8.24;

import { IBridge } from "src/interfaces/IBridge.sol";

library HashUtils {
    // keccak256("ETokenVoucher(address eAddress,string cAddress,uint256 amount,uint256 cNonce,uint256 expiry)");
    bytes32 internal constant ETOKEN_VOUCHER_TYPEHASH =
        0x704e7d9ac1821677a79486a3416f23085de31c5afe6e7c4b16c91c54f7608afc;

    function hash(IBridge.ETokenVoucher memory eVoucher) internal pure returns (bytes32) {
        return keccak256(
            abi.encode(
                ETOKEN_VOUCHER_TYPEHASH,
                eVoucher.eAddress,
                keccak256(abi.encodePacked(eVoucher.cAddress)),
                eVoucher.amount,
                eVoucher.cNonce,
                eVoucher.expiry
            )
        );
    }

    // keccak256("CTokenVoucher(address eAddress,string cAddress,uint256 amount,uint256 eNonce,uint256 expiry)");
    // slither-disable-next-line similar-names
    bytes32 internal constant CTOKEN_VOUCHER_TYPEHASH =
        0x6c03a579b8ed75456ceed20e1f8431e97bb7257f18289f2a9b9e60a2ef1edc78;

    function hash(IBridge.CTokenVoucher memory cVoucher) internal pure returns (bytes32) {
        return keccak256(
            abi.encode(
                CTOKEN_VOUCHER_TYPEHASH,
                cVoucher.eAddress,
                keccak256(abi.encodePacked(cVoucher.cAddress)),
                cVoucher.amount,
                cVoucher.eNonce,
                cVoucher.expiry
            )
        );
    }

    /**
     * keccak256("RefundedCTokenVoucher(CTokenVoucher cVoucher,uint256 expiry)CTokenVoucher(address eAddress,string
     * cAddress,uint256 amount,uint256 eNonce,uint256 expiry)");
     */
    bytes32 internal constant REFUNDED_CTOKEN_VOUCHER_TYPEHASH =
        0x2599b3bb5f23c2983759de39f003ec5b2b4b30f14ef2fc959bf284402f78cc0c;

    function hash(IBridge.RefundedCTokenVoucher memory refund) internal pure returns (bytes32) {
        return keccak256(abi.encode(REFUNDED_CTOKEN_VOUCHER_TYPEHASH, hash(refund.cVoucher), refund.expiry));
    }
}


