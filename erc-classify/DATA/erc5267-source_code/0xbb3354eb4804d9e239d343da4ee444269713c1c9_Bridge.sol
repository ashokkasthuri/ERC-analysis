pragma solidity 0.8.24;

import { Token } from "src/Token.sol";

interface IBridge {
    struct ETokenVoucher {
        address eAddress;
        string cAddress;
        uint256 amount;
        uint256 cNonce;
        uint256 expiry;
    }

    struct CTokenVoucher {
        address eAddress;
        string cAddress;
        uint256 amount;
        uint256 eNonce;
        uint256 expiry;
    }

    struct RefundedCTokenVoucher {
        CTokenVoucher cVoucher;
        uint256 expiry;
    }

    /// @notice The struct of the upgrade request.
    struct UpgradeRequest {
        address newImplementation;
        uint40 upgradeTimestamp;
        bytes32 dataHash;
    }

    event CTokenRequested(uint256 indexed eNonce, CTokenVoucher voucher, bool superPath);
    event ETokenClaimed(address indexed signer, uint256 indexed cNonce, uint256 claimedAmount);
    event ETokenRefunded(
        address indexed signer, uint256 indexed cNonce, uint256 expiry, uint256 refundedAmount, bool superPath
    );
    event ETokenRedeemed(address indexed signer, uint256 indexed eNonce, uint256 redeemedAmount);
    event SuperETokenClaimed(address indexed relayer, uint256 indexed cNonce, uint256 claimedAmount, uint256 fee);
    event SuperETokenRefunded(
        address indexed relayer, uint256 indexed cNonce, uint256 expiry, uint256 refundedAmount, uint256 fee
    );
    event SuperETokenRedeemed(address indexed relayer, uint256 indexed eNonce, uint256 redeemedAmount, uint256 fee);
    event CVoucherExpirySet(uint256 expiry);
    event MinimumRequestAmountSet(uint256 eAmount);
    event SuperPathEnabled();
    event UpgradeDelaySet(uint32 delay);
    event UpgradeRequested(address indexed newImplementation, bytes32 dataHash, uint40 upgradeTimestamp);
    event UpgradeRequestCancelled(address indexed newImplementation, bytes32 dataHash);

    error ZeroAddress();
    error ZeroAmount();
    error Unauthorized();
    error VoucherExpired();
    error VoucherStillActive();
    error NonceAlreadyUsed();
    error BelowMinimumAmount(uint256 minimum, uint256 requested);
    error SuperPathNotEnabled();
    error InsufficientAllowance();
    error BelowMinimumUpgradeDelay(uint32 minimum, uint32 requested);
    error NoUpgradeRequested();
    error UpgradeNotReady(uint40 upgradeTimestamp);
    error InvalidUpgradeRequestImplementation(address newImplementation, address requestedImplementation);
