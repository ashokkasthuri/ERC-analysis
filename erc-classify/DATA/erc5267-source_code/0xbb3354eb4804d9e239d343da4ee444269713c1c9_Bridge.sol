pragma solidity 0.8.24;

import { UUPSUpgradeable } from "@ozu/proxy/utils/UUPSUpgradeable.sol";
import { AccessControlEnumerableUpgradeable } from "@ozu/access/extensions/AccessControlEnumerableUpgradeable.sol";
import { PausableUpgradeable } from "@ozu/utils/PausableUpgradeable.sol";
import { EIP712Upgradeable } from "@ozu/utils/cryptography/EIP712Upgradeable.sol";
import { ECDSA } from "@oz/utils/cryptography/ECDSA.sol";
import { HashUtils } from "src/libraries/HashUtils.sol";
import { BridgeStorage } from "src/libraries/BridgeStorage.sol";
import { IBridge } from "src/interfaces/IBridge.sol";
import { Token } from "src/Token.sol";

contract Bridge is
    IBridge,
    UUPSUpgradeable,
    AccessControlEnumerableUpgradeable,
    PausableUpgradeable,
    EIP712Upgradeable
{
    using HashUtils for *;

    uint8 private constant _CTOKEN_DECIMALS = 6;

    /// @notice The default minimum amount of eTokens that can be requested.
    uint256 private constant _DEFAULT_MINIMUM_REQUEST_AMOUNT = 500e18;
    /// @notice The minimum delay for upgrade requests.
    uint32 private constant _MINIMUM_UPGRADE_DELAY = 48 hours;
    /// @inheritdoc IBridge
    bytes32 public constant UPGRADER_ROLE = 0x189ab7a9244df0848122154315af71fe140f3db0fe014031783b0946b8c9d2e3;
    /// @inheritdoc IBridge
    bytes32 public constant BRIDGE_ADMIN_ROLE = 0x751b795d24b92e3d92d1d0d8f2885f4e9c9c269da350af36ae6b49069babf4bf;
    /// @inheritdoc IBridge
    bytes32 public constant SIGNER_ROLE = 0xe2f4eaae4a9751e85a3e4a7b9587827a877f29914755229b07a7b2da98285f70;
    /// @inheritdoc IBridge
    bytes32 public constant RELAYER_ROLE = 0xe2b7fb3b832174769106daebcfd6d1970523240dda11281102db9363b83b0dc4;
    /// @inheritdoc IBridge
    Token public immutable eToken;
    /// @inheritdoc IBridge
    uint256 public immutable SCALE_FACTOR;

    constructor(Token eToken_) {
        if (address(eToken_) == address(0)) revert ZeroAddress();
        SCALE_FACTOR = 10 ** eToken_.decimals() / 10 ** _CTOKEN_DECIMALS;
        eToken = eToken_;

        _disableInitializers();
    }

    function initialize(
        address defaultAdmin,
        address upgrader,
        address bridgeAdmin,
        address[] calldata relayers,
        address[] calldata signers,
        uint32 cVoucherExpiry_
    )
        external
        initializer
    {
        if (defaultAdmin == address(0)) revert ZeroAddress();
        if (upgrader == address(0)) revert ZeroAddress();
        if (bridgeAdmin == address(0)) revert ZeroAddress();

        __UUPSUpgradeable_init();
        __AccessControlEnumerable_init();
        __Pausable_init();
        __EIP712_init("ETH-Cosmos-Bridge", "V1");

        _setCVoucherExpiry(cVoucherExpiry_);
        _setMinimumRequestAmount(_DEFAULT_MINIMUM_REQUEST_AMOUNT);
        _setUpgradeDelay(_MINIMUM_UPGRADE_DELAY);

        BridgeStorage.Storage storage $ = BridgeStorage.get();
        // Initialize eNonce to 1 to match with Cosmos chain.
        $.eNonce = 1;

        _setRoleAdmin(RELAYER_ROLE, BRIDGE_ADMIN_ROLE);
        _setRoleAdmin(SIGNER_ROLE, BRIDGE_ADMIN_ROLE);
        _grantRole(DEFAULT_ADMIN_ROLE, defaultAdmin);
        _grantRole(UPGRADER_ROLE, upgrader);
        _grantRole(BRIDGE_ADMIN_ROLE, bridgeAdmin);
        for (uint256 i = 0; i < relayers.length; i++) {
            if (relayers[i] == address(0)) revert ZeroAddress();
            _grantRole(RELAYER_ROLE, relayers[i]);
        }
        for (uint256 i = 0; i < signers.length; i++) {
            if (signers[i] == address(0)) revert ZeroAddress();
            _grantRole(SIGNER_ROLE, signers[i]);
        }
    }

    /// @inheritdoc IBridge
    function requestCToken(uint256 eAmount, string calldata cAddress, bool superPath) external whenNotPaused {
        _requestCTokens(msg.sender, eAmount, cAddress, superPath);
    }

    /// @inheritdoc IBridge
    function requestCTokenWithPermit(
        uint256 eAmount,
        string calldata cAddress,
        bool superPath,
        uint256 deadline,
        uint8 v,
        bytes32 r,
        bytes32 s
    )
        external
        whenNotPaused
    {
        // slither-disable-next-line reentrancy-events
        try eToken.permit(msg.sender, address(this), eAmount, deadline, v, r, s) {
            // solhint-disable-previous-line no-empty-blocks
        } catch {
            if (eToken.allowance(msg.sender, address(this)) < eAmount) {
                revert InsufficientAllowance();
            }
        }
        _requestCTokens(msg.sender, eAmount, cAddress, superPath);
    }

    /// @inheritdoc IBridge
    function claimEToken(ETokenVoucher calldata voucher, bytes calldata signature) external whenNotPaused {
        if (msg.sender != voucher.eAddress) revert Unauthorized();
        if (voucher.expiry < block.timestamp) revert VoucherExpired();
        address signer = _validateAndUseEVoucher(voucher, signature);

        emit ETokenClaimed(signer, voucher.cNonce, voucher.amount);
        _mintETokens(msg.sender, voucher.amount);
    }

    /// @inheritdoc IBridge
    function superClaimEToken(
        ETokenVoucher calldata voucher,
        uint256 fee
    )
        external
        whenNotPaused
        onlyRole(RELAYER_ROLE)
    {
        if (voucher.expiry < block.timestamp) revert VoucherExpired();
        _useEVoucher(voucher);

        (uint256 claimedAmount, uint256 feeAmount) = _calculateFeeAmounts(voucher.amount, fee);

        emit SuperETokenClaimed(msg.sender, voucher.cNonce, claimedAmount, feeAmount);
        _mintETokens(voucher.eAddress, claimedAmount);
    }

    /// @inheritdoc IBridge
    function refundVoucher(
        ETokenVoucher calldata voucher,
        bytes calldata signature,
        bool superPath
    )
        external
        whenNotPaused
    {
        if (block.timestamp < voucher.expiry && msg.sender != voucher.eAddress) revert VoucherStillActive();
        BridgeStorage.Storage storage $ = BridgeStorage.get();

        if (superPath && !$.superPathEnabled) revert SuperPathNotEnabled();

        address signer = _validateAndUseEVoucher(voucher, signature);
        uint256 expiry = block.timestamp + $.cVoucherExpiry;
        emit ETokenRefunded(signer, voucher.cNonce, expiry, voucher.amount, superPath);
    }

    /// @inheritdoc IBridge
    function superRefundVoucher(
        ETokenVoucher calldata voucher,
        uint256 fee
    )
        external
        whenNotPaused
        onlyRole(RELAYER_ROLE)
    {
        _useEVoucher(voucher);

        (uint256 refundedAmount, uint256 feeAmount) = _calculateFeeAmounts(voucher.amount, fee);

        uint256 expiry = block.timestamp + BridgeStorage.get().cVoucherExpiry;
        emit SuperETokenRefunded(msg.sender, voucher.cNonce, expiry, refundedAmount, feeAmount);
    }

    /// @inheritdoc IBridge
    function redeemVoucher(RefundedCTokenVoucher calldata refund, bytes calldata signature) external whenNotPaused {
        // If sender is not voucher owner and voucher is still active
        if (msg.sender != refund.cVoucher.eAddress && refund.expiry >= block.timestamp) revert Unauthorized();

        address signer = _validateAndUseRefundVoucher(refund, signature);

        uint256 eTokenAmount = _c2e(refund.cVoucher.amount);
        emit ETokenRedeemed(signer, refund.cVoucher.eNonce, eTokenAmount);
        _mintETokens(refund.cVoucher.eAddress, eTokenAmount);
    }

    /// @inheritdoc IBridge
    function superRedeemVoucher(
        RefundedCTokenVoucher calldata refund,
        uint256 fee
    )
        external
        whenNotPaused
        onlyRole(RELAYER_ROLE)
    {
        _useCVoucher(refund.cVoucher);

        (uint256 reedemedAmount, uint256 feeAmount) = _calculateFeeAmounts(_c2e(refund.cVoucher.amount), _c2e(fee));

        emit SuperETokenRedeemed(msg.sender, refund.cVoucher.eNonce, reedemedAmount, feeAmount);
        _mintETokens(refund.cVoucher.eAddress, reedemedAmount);
    }

    /// @inheritdoc IBridge
    function setCVoucherExpiry(uint32 expiry) external onlyRole(BRIDGE_ADMIN_ROLE) {
        _setCVoucherExpiry(expiry);
    }

    /// @inheritdoc IBridge
    function setMinimumRequestAmount(uint256 eAmount) external onlyRole(BRIDGE_ADMIN_ROLE) {
        _setMinimumRequestAmount(eAmount);
    }

    /// @inheritdoc IBridge
    function setUpgradeDelay(uint32 delay) external onlyRole(BRIDGE_ADMIN_ROLE) {
        if (delay < _MINIMUM_UPGRADE_DELAY) revert BelowMinimumUpgradeDelay(_MINIMUM_UPGRADE_DELAY, delay);

        _setUpgradeDelay(delay);
    }

    /// @inheritdoc IBridge
    function requestUpgrade(address newImplementation, bytes calldata data) external onlyRole(UPGRADER_ROLE) {
        BridgeStorage.Storage storage $ = BridgeStorage.get();

        uint40 upgradeTimestamp = uint40(block.timestamp) + $.upgradeDelay;
        bytes32 dataHash = keccak256(abi.encodePacked(data));

        $.upgradeRequest = UpgradeRequest({
            newImplementation: newImplementation,
            dataHash: dataHash,
            upgradeTimestamp: upgradeTimestamp
        });

        emit UpgradeRequested(newImplementation, dataHash, upgradeTimestamp);
    }

    /// @inheritdoc IBridge
    function cancelUpgradeRequest() external onlyRole(UPGRADER_ROLE) {
        BridgeStorage.Storage storage $ = BridgeStorage.get();
        UpgradeRequest memory request = $.upgradeRequest;

        delete $.upgradeRequest;

        emit UpgradeRequestCancelled(request.newImplementation, request.dataHash);
    }

    /// @inheritdoc IBridge
    function pause() external whenNotPaused onlyRole(BRIDGE_ADMIN_ROLE) {
        _pause();
    }

    /// @inheritdoc IBridge
    function unpause() external whenPaused onlyRole(BRIDGE_ADMIN_ROLE) {
        _unpause();
    }

    /// @inheritdoc IBridge
    function enableSuperPath() external onlyRole(BRIDGE_ADMIN_ROLE) {
        BridgeStorage.get().superPathEnabled = true;
        emit SuperPathEnabled();
    }

    /// @inheritdoc IBridge
    function nextENonce() external view returns (uint256) {
        return BridgeStorage.get().eNonce;
    }

    /// @inheritdoc IBridge
    function isENonceUsed(uint256 nonce) external view returns (bool) {
        return BridgeStorage.get().usedENonces[nonce];
    }

    /// @inheritdoc IBridge
    function isCNonceUsed(uint256 nonce) external view returns (bool) {
        return BridgeStorage.get().usedCNonces[nonce];
    }

    /// @inheritdoc IBridge
    function cVoucherExpiry() external view returns (uint32) {
        return BridgeStorage.get().cVoucherExpiry;
    }

    /// @inheritdoc IBridge
    function minimumRequestAmount() external view returns (uint256) {
        return BridgeStorage.get().minimumRequestAmount;
    }

    /// @inheritdoc IBridge
    function upgradeDelay() external view returns (uint32) {
        return BridgeStorage.get().upgradeDelay;
    }

    /// @inheritdoc IBridge
    function upgradeRequest() external view returns (UpgradeRequest memory) {
        return BridgeStorage.get().upgradeRequest;
    }

    /// @inheritdoc IBridge
    function superPathEnabled() external view returns (bool) {
        return BridgeStorage.get().superPathEnabled;
    }

    /// @inheritdoc UUPSUpgradeable
    function upgradeToAndCall(address newImplementation, bytes memory data) public payable override onlyProxy {
        BridgeStorage.Storage storage $ = BridgeStorage.get();

        UpgradeRequest memory request = $.upgradeRequest;
        if (request.newImplementation == address(0)) revert NoUpgradeRequested();
        if (request.upgradeTimestamp > block.timestamp) revert UpgradeNotReady(request.upgradeTimestamp);
        if (newImplementation != request.newImplementation) {
            revert InvalidUpgradeRequestImplementation(newImplementation, request.newImplementation);
        }
        bytes32 dataHash = keccak256(abi.encodePacked(data));
        if (dataHash != request.dataHash) revert InvalidUpgradeRequestData(dataHash, request.dataHash);

        delete $.upgradeRequest;

        super.upgradeToAndCall(newImplementation, data);
    }

    function _authorizeUpgrade(address newImplementation) internal override onlyRole(UPGRADER_ROLE) {
        // solhint-disable-previous-line no-empty-blocks
    }

    function _requestCTokens(address owner, uint256 eAmount, string calldata cAddress, bool superPath) internal {
        if (eAmount == 0) revert ZeroAmount();
        BridgeStorage.Storage storage $ = BridgeStorage.get();
        if (superPath && !$.superPathEnabled) revert SuperPathNotEnabled();

        uint256 minRequestAmount = $.minimumRequestAmount;
        if (eAmount < minRequestAmount) revert BelowMinimumAmount(minRequestAmount, eAmount);

        uint256 cAmount = _e2c(eAmount);

        uint256 eNonce = $.eNonce;
        unchecked {
            $.eNonce = eNonce + 1;
        }

        CTokenVoucher memory voucher = CTokenVoucher({
            eAddress: owner,
            cAddress: cAddress,
            amount: cAmount,
            eNonce: eNonce,
            expiry: block.timestamp + $.cVoucherExpiry
        });
        emit CTokenRequested(voucher.eNonce, voucher, superPath);
        // Save trailing tokens from being burned.
        eToken.burnFrom(owner, _c2e(cAmount));
    }

    function _setCVoucherExpiry(uint32 expiry) internal {
        BridgeStorage.get().cVoucherExpiry = expiry;
        emit CVoucherExpirySet(expiry);
    }

    function _setMinimumRequestAmount(uint256 eAmount) internal {
        BridgeStorage.get().minimumRequestAmount = eAmount;
        emit MinimumRequestAmountSet(eAmount);
    }

    function _setUpgradeDelay(uint32 delay) internal {
        BridgeStorage.get().upgradeDelay = delay;

        emit UpgradeDelaySet(delay);
    }

    function _mintETokens(address to, uint256 amount) internal {
        if (amount > 0) {
            eToken.mint(to, amount);
        }
    }

    function _validateAndUseEVoucher(
        ETokenVoucher calldata voucher,
        bytes calldata signature
    )
        internal
        returns (address signer)
    {
        signer = _validateSignature(voucher.hash(), signature);
        _useEVoucher(voucher);
    }

    function _useEVoucher(ETokenVoucher calldata voucher) internal {
        BridgeStorage.Storage storage $ = BridgeStorage.get();
        if ($.usedCNonces[voucher.cNonce]) revert NonceAlreadyUsed();
        $.usedCNonces[voucher.cNonce] = true;
    }

    function _validateAndUseRefundVoucher(
        RefundedCTokenVoucher calldata refund,
        bytes calldata signature
    )
        internal
        returns (address signer)
    {
        signer = _validateSignature(refund.hash(), signature);
        _useCVoucher(refund.cVoucher);
    }

    function _useCVoucher(CTokenVoucher calldata voucher) internal {
        BridgeStorage.Storage storage $ = BridgeStorage.get();
        if ($.usedENonces[voucher.eNonce]) revert NonceAlreadyUsed();
        $.usedENonces[voucher.eNonce] = true;
    }

    function _validateSignature(bytes32 structHash, bytes memory signature) internal view returns (address signer) {
        signer = ECDSA.recover(_hashTypedDataV4(structHash), signature);
        if (!hasRole(SIGNER_ROLE, signer)) revert Unauthorized();
    }

    function _calculateFeeAmounts(uint256 amount, uint256 fee) internal pure returns (uint256, uint256) {
        unchecked {
            return fee >= amount ? (0, amount) : (amount - fee, fee);
        }
    }

    function _e2c(uint256 eAmount) private view returns (uint256) {
        return eAmount / SCALE_FACTOR;
    }

    function _c2e(uint256 cAmount) private view returns (uint256) {
        return cAmount * SCALE_FACTOR;
    }
}


