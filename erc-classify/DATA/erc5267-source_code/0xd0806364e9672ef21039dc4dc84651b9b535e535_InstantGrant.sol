pragma solidity 0.8.20;

import {IGrant} from "src/interfaces/IGrant.sol";
import {Ownable} from "openzeppelin-contracts/contracts/access/Ownable.sol";
import {KSRescue} from "./KSRescue.sol";
import {ECDSA} from "openzeppelin-contracts/contracts/utils/cryptography/ECDSA.sol";
import {MerkleProof} from "openzeppelin-contracts/contracts/utils/cryptography/MerkleProof.sol";
import {EIP712} from "openzeppelin-contracts/contracts/utils/cryptography/EIP712.sol";

abstract contract Grant is IGrant, EIP712, KSRescue {
    /// @inheritdoc	IGrant
    bytes32 public immutable messageHash;

    /// @inheritdoc	IGrant
    bytes32 public immutable override merkleRoot;

    /// @inheritdoc	IGrant
    mapping(address account => bool status) public override blacklisted;

    /// keccak256("Agreement(uint256 leafIndex,string termsAndConditions)")
    /// @inheritdoc	IGrant
    bytes32 public constant AGREEMENT_TYPEHASH = 0x7f8f187c97a8a2b9d455ee04a0650eb4ff0c52a86227f4db2447a48fe5d3c741;

    constructor(
        address _initialOwner,
        bytes32 _root,
        address[] memory _initialOperators,
        address[] memory _guardians,
        bytes32 _msgHash
    ) Ownable(_initialOwner) {
        if (_initialOwner == address(0)) revert InvalidAddress();
        if (_root == hex"00") revert InvalidMerkleRoot();
        if (_msgHash == hex"00") revert InvalidMsgHash();

        messageHash = _msgHash;
        merkleRoot = _root;
        emit MerkleRootSet(_root);

        for (uint256 i; i < _initialOperators.length;) {
            operators[_initialOperators[i]] = true;
            emit UpdateOperator(_initialOperators[i], true);
            unchecked {
                ++i;
            }
        }

        guardians[_initialOwner] = true;
        emit UpdateGuardian(_initialOwner, true);

        for (uint256 i; i < _guardians.length;) {
            guardians[_guardians[i]] = true;
            emit UpdateGuardian(_guardians[i], true);
            unchecked {
                ++i;
            }
        }
    }

    /// @inheritdoc	IGrant
    function blacklist(address account, bool status) external onlyOwner {
        blacklisted[account] = status;
        emit BlacklistStatusSet(account, status);
    }

    /// @inheritdoc	IGrant
    function isValidSignature(bytes calldata signature, address signer, uint256 leafIndex) public view returns (bool) {
        return ECDSA.recover(
            _hashTypedDataV4(keccak256(abi.encode(AGREEMENT_TYPEHASH, leafIndex, messageHash))), signature
        ) == signer;
    }

    /// @inheritdoc	IGrant
    function domainSeparator() external view returns (bytes32) {
        return _domainSeparatorV4();
    }

    /// @dev internal function to verify merkle proof. Assume that leaf is already double hashed, as best practice to prevent second preimage attack in merkle tree
    function _verifyProof(bytes32[] calldata proof, bytes32 leaf) internal view returns (bool valid) {
        valid = MerkleProof.verifyCalldata(proof, merkleRoot, leaf);
    }
}


