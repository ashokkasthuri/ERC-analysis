pragma solidity 0.8.20;

import {Grant, EIP712} from "src/Grant.sol";
import {IInstantGrant} from "src/interfaces/IInstantGrant.sol";
import {SafeERC20, IERC20} from "openzeppelin-contracts/contracts/token/ERC20/utils/SafeERC20.sol";
import {Math} from "openzeppelin-contracts/contracts/utils/math/Math.sol";
import {MerkleProof} from "openzeppelin-contracts/contracts/utils/cryptography/MerkleProof.sol";
import {ReentrancyGuard} from "openzeppelin-contracts/contracts/utils/ReentrancyGuard.sol";

/// @title InstantGrant
/// @author Kyber SC Team
/// @notice InstantGrant supports granting funds instantly given that claimers have valid merkle proof and have signed terms of condition
/// The contract supports multiple claiming tokens
/// @dev ONLY support ERC-20 token
contract InstantGrant is Grant, ReentrancyGuard, IInstantGrant {
    /// @inheritdoc	IInstantGrant
    mapping(uint256 index => bool status) public override claimed;

    constructor(
        address _initialOwner,
        bytes32 _root,
        address[] memory _initialOperators,
        address[] memory _guardians,
        bytes32 _msgHash
    ) Grant(_initialOwner, _root, _initialOperators, _guardians, _msgHash) EIP712("Kyberswap Instant Grant", "1") {}

    /// @inheritdoc	IInstantGrant
    function claim(InstantClaimData calldata claimData, bytes32[] calldata proof, bytes calldata signature)
        external
        whenNotPaused
        nonReentrant
    {
        if (claimData.receiver != msg.sender && !operators[msg.sender]) revert NotAuthorized(msg.sender);
        if (blacklisted[claimData.receiver]) revert Blacklisted(claimData.receiver);
        if (claimed[claimData.index]) revert AlreadyClaimed(claimData.index);

        // validate proof against merkle root
        if (!isValidClaim(claimData, proof)) revert InvalidProof();

        // validate signature against message hash
        // No need to check if signer == address(0) since it is validated in ECDSA library
        if (!isValidSignature(signature, claimData.receiver, claimData.index)) revert InvalidSignature();

        // Set claim status to true for the index
        claimed[claimData.index] = true;

        uint256 len = claimData.tokenInfo.length;

        for (uint256 i; i < len;) {
            SafeERC20.safeTransfer(
                IERC20(claimData.tokenInfo[i].token), claimData.receiver, claimData.tokenInfo[i].amount
            );

            unchecked {
                ++i;
            }
        }

        emit Claimed(claimData.index, claimData.receiver, claimData.tokenInfo);
    }

    /// @inheritdoc	IInstantGrant
    function isValidClaim(InstantClaimData calldata data, bytes32[] calldata proof) public view returns (bool valid) {
        bytes32 leaf = keccak256(bytes.concat(keccak256(abi.encode(data))));

        valid = _verifyProof(proof, leaf);
    }
}


