pragma solidity ^0.8.0;

interface IInstantGrant {
    error AlreadyClaimed(uint256 index);

    /// @param token The address of token
    /// @param amount The amount of token
    struct TokenInfo {
        address token;
        uint256 amount;
    }

    /// @notice Claim data for instant grant
    /// @dev Data for merkle tree's leaf. It is encoded as `bytes` before get double hashed.
    /// The merkle leaf is computed as `keccak256(abi.encode(keccak256(abi.encode(InstantClaimData))))`
    /// @param index Unique index of the leaf
    /// @param receiver The address to receive token
    /// @param tokenInfo List of token info
    struct InstantClaimData {
        uint256 index;
        address receiver;
        TokenInfo[] tokenInfo;
    }

    /// @notice Emit when an account claims token
    /// @param index The index of the merkle leaf
    /// @param receiver The address of the receiver
    /// @param tokenInfo The list of the tokens and amounts
    event Claimed(uint256 indexed index, address indexed receiver, TokenInfo[] tokenInfo);

    /// @notice Use this function to claim tokens for users
    /// @dev This function must only be called by operator, or the receiver according to the proof
    /// @param data Claim data
    /// @param proof Merkle proof according to current merkle root
    /// @param signature Signature for terms of condition
    function claim(InstantClaimData calldata data, bytes32[] calldata proof, bytes calldata signature) external;

    /// @notice Check whether the data and proof is valid
    /// @dev This does not check if the claim index is used or not, only check validity of the proof
    /// @param data Claim data
    /// @param proof Merkle proof according to current merkle root
    /// @return True if the data and proof is valid, otherwise false
    function isValidClaim(InstantClaimData calldata data, bytes32[] calldata proof) external view returns (bool);

    /// @notice Check if grant index `index` claimed or not
    /// @param index The index of the merkle leaf
    /// @return True if claimed, otherwise false
    function claimed(uint256 index) external view returns (bool);
}


