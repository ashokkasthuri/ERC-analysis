      <!-- Batch Transfer Security -->
      <FlowElement>
        <Type>Block</Type>
        <BlockID>BL_batch_transfer_security</BlockID>
        <Description>Batch Transfer Security</Description>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID17</QuestionID>
          <DataExportTag>aware_batch_transfer_risks</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I am aware that incorrect implementation of safeBatchTransferFrom may increase risks due to large token batches.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID18</QuestionID>
          <DataExportTag>understand_batch_transfer_risks</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I understand that failing to correctly implement safeBatchTransferFrom (approval checks, array length checks, receiver interface validation) can result in tokens being locked or unrecoverable.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID19</QuestionID>
          <DataExportTag>consider_delegated_approvals_valid</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;If an owner grants approval to an operator using setApprovalForAll, and that operator delegates secondary or tertiary approvals to others, I consider such approvals valid and authentic.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID20</QuestionID>
          <DataExportTag>familiar_phishing_risks</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I am familiar with phishing risks associated with setApprovalForAll, where malicious actors can exploit broad approvals.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID21</QuestionID>
          <DataExportTag>spec_should_address_approval_duration</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I believe the current setApprovalForAll specification in ERC-721/1155 should address approval duration and secondary approval validity at the protocol level.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID22</QuestionID>
          <DataExportTag>expiry_mechanisms_effective</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;Introducing expiry mechanisms (e.g., approveForAll(operator, expiryTimestamp)) would effectively mitigate approval-related risks.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID23</QuestionID>
          <DataExportTag>aware_receiver_hooks</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I am aware that to safely receive tokens, a contract must implement receiver hooks such as tokensReceived, onERC1155BatchReceived, or onTransferReceived.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID24</QuestionID>
          <DataExportTag>aware_reentrancy_risks</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I am aware that receiver hooks can introduce reentrancy vulnerabilities and must follow the checks–effects–interactions pattern.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
