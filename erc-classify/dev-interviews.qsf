              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID16</QuestionID>
          <DataExportTag>tooling_supports_dependency_management</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;The current tooling (specification documents, utilities) adequately supports developers in ERC dependency management with clear organization of mandatory specifications.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
