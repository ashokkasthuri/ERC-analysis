            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID14</QuestionID>
          <DataExportTag>encountered_interoperability_issues</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I have encountered interoperability issues due to missing ERC dependencies in deployed smart contracts.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
