<?xml version="1.0" encoding="UTF-8"?>
<Survey xmlns="http://qualtrics.com/2.5/API" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="RootElement">
  <SurveyID>SV_developer_survey</SurveyID>
  <SurveyName>Developer Survey Questionnaire</SurveyName>
  <SurveyDescription>Survey on developers' experiences, practices, and perspectives on ERC standards, dependencies, and security considerations in smart contract development.</SurveyDescription>
  <SurveyEntry>
    <Type>Root</Type>
    <Flow>
      <FlowElement>
        <Type>Block</Type>
        <BlockID>BL_background</BlockID>
        <Description>Background and Practice</Description>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID1</QuestionID>
          <DataExportTag>years_experience</DataExportTag>
          <QuestionText>How many years of experience do you have with smart contract development?</QuestionText>
          <QuestionType>TE</QuestionType>
          <Selector>SL</Selector>
          <Configuration>
            <QuestionTextOption>UseText</QuestionTextOption>
          </Configuration>
          <Validation>
            <Settings>
              <ForceResponse>ON</ForceResponse>
              <Type>ContentType</Type>
              <ContentType>ValidNumber</ContentType>
            </Settings>
          </Validation>
        </BlockElements>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID2</QuestionID>
          <DataExportTag>experience_rating</DataExportTag>
          <QuestionText>On a scale of 1-5, how would you rate your experience with smart contract development?</QuestionText>
          <QuestionType>MC</QuestionType>
          <Selector>DL</Selector>
          <SubSelector>TX</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>1 (Beginner)</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>2</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>3 (Intermediate)</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>4</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>5 (Expert)</Description>
            </Choice>
          </Choices>
        </BlockElements>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID3</QuestionID>
          <DataExportTag>erc_frequency</DataExportTag>
          <QuestionText>How frequently do you work with ERC standards in your projects?</QuestionText>
          <QuestionType>MC</QuestionType>
          <Selector>DL</Selector>
          <SubSelector>TX</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Never</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Rarely</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Occasionally</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Frequently</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Always</Description>
            </Choice>
          </Choices>
        </BlockElements>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID4</QuestionID>
          <DataExportTag>erc_standards_used</DataExportTag>
          <QuestionText>Which ERC standards have you implemented or interacted with most frequently?</QuestionText>
          <QuestionType>TE</QuestionType>
          <Selector>ML</Selector>
          <Configuration>
            <QuestionTextOption>UseText</QuestionTextOption>
          </Configuration>
        </BlockElements>
      </BlockElement>

      <!-- Likert Scale Questions - Background and Practice -->
      <FlowElement>
        <Type>Block</Type>
        <BlockID>BL_likert_background</BlockID>
        <Description>Background and Practice (Likert Questions)</Description>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID5</QuestionID>
          <DataExportTag>specs_clear_doc_sufficient</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I find ERC standard specifications clear and easy to implement, and current documentation for ERC standards is sufficient for implementation.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>
        
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID6</QuestionID>
          <DataExportTag>verify_against_specs</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I regularly verify my implementations against official standard specifications.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>
        
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID7</QuestionID>
          <DataExportTag>compatibility_issues</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I encounter compatibility issues due to different interpretations or misunderstandings of ERC standards.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID8</QuestionID>
          <DataExportTag>security_influences_choice</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;Security considerations highly influence my choice of which ERC standard to implement in a project.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID9</QuestionID>
          <DataExportTag>security_implementations_frequency</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;How often do you use or encounter smart contract development with security-related implementations such as Signature (ECDSA), Nonce, Deadline, or DOMAIN_SEPARATOR?&lt;/div&gt;</QuestionText>
          <QuestionType>MC</QuestionType>
          <Selector>DL</Selector>
          <SubSelector>TX</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Never</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Rarely</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Occasionally</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Frequently</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Always</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID10</QuestionID>
          <DataExportTag>security_terms_difficult</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;It is very difficult to understand these security-related terms (Signature (ECDSA), Nonce, Deadline, DOMAIN_SEPARATOR) from the specification documents, and expert evaluation or automated auditing is often needed for correctness.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID11</QuestionID>
          <DataExportTag>prefer_existing_contracts</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I prefer following an existing deployed contract when implementing ERC standards rather than re-implementing specifications manually from scratch.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>

        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID12</QuestionID>
          <DataExportTag>targeted_analysis_important</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;It is important to conduct targeted function analysis for compliance and vulnerabilities (e.g., safeBatchTransferFrom, setApprovalForAll) instead of general smart contract issue studies.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
            </Choice>
            <Choice>
              <ChoiceID>4</ChoiceID>
              <Description>Agree</Description>
            </Choice>
            <Choice>
              <ChoiceID>5</ChoiceID>
              <Description>Strongly Agree</Description>
            </Choice>
          </Choices>
        </BlockElements>
      </BlockElement>

      <!-- Dependency Management and Interoperability -->
      <FlowElement>
        <Type>Block</Type>
        <BlockID>BL_dependency_management</BlockID>
        <Description>Dependency Management and Interoperability</Description>
        <BlockElements>
          <Type>Question</Type>
          <QuestionID>QID13</QuestionID>
          <DataExportTag>easy_discover_dependencies</DataExportTag>
          <QuestionText>&lt;div style='text-align: left;'&gt;I find it easy to discover dependencies between different ERC standards considering their functional and event-level relationships.&lt;/div&gt;</QuestionText>
          <QuestionType>Matrix</QuestionType>
          <Selector>Likert</Selector>
          <SubSelector>SingleAnswer</SubSelector>
          <Choices>
            <Choice>
              <ChoiceID>1</ChoiceID>
              <Description>Strongly Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>2</ChoiceID>
              <Description>Disagree</Description>
            </Choice>
            <Choice>
              <ChoiceID>3</ChoiceID>
              <Description>Neutral</Description>
